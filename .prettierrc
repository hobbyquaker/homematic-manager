{
    "tabWidth": 4,
    "singleQuote": true,
    "bracketSpacing": false,
    "printWidth": 120,
    "plugins": ["prettier-plugin-svelte"],
    "overrides": [
        {
            "files": ["*.json", "*.yml", "*.yaml", "*.md"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.svelte"],
            "options": {
                "parser": "svelte"
            }
        }
    ]
}
