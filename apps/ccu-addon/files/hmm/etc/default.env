# Configuration of the Homematic Manager addon's *host process*. Copied to etc/hmm.env on the
# first install and never overwritten again, so edits survive an update.
#
# Everything about the CCU itself - interfaces, ReGa, callback addresses, pacing, language - is
# configured in the UI's settings dialog and stored in /usr/local/hmm/config.json. There is
# nothing about it here on purpose: the addon runs on the CCU, so it already knows where it is.
#
# Every option of the host has an HMM_* environment mirror (`homematic-manager-web --help`), so
# anything else may be added here as well; the flags the rc.d script passes (--local, --base,
# --host, --no-issue-cookie, --data-dir) win over this file.

# TCP port of the backend on 127.0.0.1. lighttpd proxies /addons/hmm/ to it. When this is changed,
# /usr/local/etc/config/lighttpd/hmm.conf has to be changed with it - re-running update_script
# does that, or edit both by hand and restart lighttpd.
HMM_PORT=8090

# error, warn, info, debug. The log is /var/log/hmm.log, or var/hmm.log in the addon directory - see
# HMM_ADDON_LOG below - and service.cgi?cmd=log shows it; on openccu-lite it is the journal instead:
# the box's Log page (unit addon-hmm), journalctl -t addon-hmm.
HMM_LOG_LEVEL=info

# Task 43 (#159): where that log goes on a CCU and OpenCCU. Both files are rotated at 1 MB.
#   varlog  /var/log/hmm.log, the default when this is unset: the CCU's own log directory, on a
#           tmpfs, so nothing is written to the SD card - and the log is gone after a reboot.
#   addon   /usr/local/addons/hmm/var/hmm.log: survives a reboot, and writes to the SD card.
# The start after a switch removes the file at the other location. When /var/log cannot be written
# the log goes to the addon directory, and syslog says so. Also settable from the addon's settings
# page, /addons/hmm/settings.cgi?cmd=config. Not used on openccu-lite, where the log is the journal.
#HMM_ADDON_LOG=addon

# Task 35: the callback ports while the settings dialog says 0 for them, which is its default. The
# rc.d script sets 2031 for XML-RPC and 2032 for BIN-RPC; ports set in the settings dialog win over
# both, and a taken one is replaced by a free port for that start. 0 gives a free port at every
# start, the way it was before.
#HMM_CALLBACK_XMLRPC_DEFAULT_PORT=2031
#HMM_CALLBACK_BINRPC_DEFAULT_PORT=2032

# B-32: flags for node itself, read by the rc.d script and not by the host. Unset, node runs with
# the addon's memory flags (the addon's README, "Memory"); empty runs it without flags. --lite-mode
# and --jitless are dropped wherever they are set: both switch off WebAssembly, and node's fetch
# needs it (3.0.0-beta.16 started node with --lite-mode, and the addon could not log anybody in).
#HMM_NODE_FLAGS=

# D-32/D-40: how a browser is let into the UI.
#
# **Unset is the right answer on both firmwares**: the rc.d script looks at /VERSION at every start
# and picks `occulite` on an openccu-lite box and `token` on a CCU. Setting it here overrides that,
# and it then stays wrong if the same /usr/local is later moved to the other firmware (which is a
# supported move, openccu-lite's D-17).
#
#   token     the way task 13 built it: the button in Systemsteuerung opens settings.cgi, which
#             asks ReGaHSS whether the caller has a WebUI session and only then hands out the token
#             cookie. Nothing else gets in.
#   rega      CCU only. Additionally: a request without a session gets a small login page and has
#             to name a user of this CCU. The user is looked up in ReGa (ID_USERS, on
#             127.0.0.1:8183) and the password is checked by the CCU's own authentication daemon
#             (udp 1998) - the same two services the WebUI itself uses, no JSON-API (D-1). The
#             settings.cgi hand-over keeps working exactly as before and never sees the login page.
#   occulite  openccu-lite only, and its default. The box's shell opens the addon with the user's
#             session on the URL (?sid=@xxxxxxxxxx@); this host checks that session against the
#             box's metadata API and turns it into one of its own. There is no login form here -
#             the users are the box's - so a browser without a session is sent to the box's login.
#             The session is also what a rename of a device is written to the box's store as.
#             Since 3.0.0-beta.16 a request without ?sid= and without this host's cookie is also let
#             in by the session openccu-lite's lighttpd gate passes as the X-Occulite-Session
#             header, once the box confirms it (/api/auth/v1/state). The header is never read in
#             the other two modes: a CCU's lighttpd passes a header a browser sent straight through.
#
# `rega` only works on the CCU: both services it asks are loopback-only, which is why the npm and
# Docker installs stay on `token` and are told so when they ask for anything else. Also settable
# from the addon's settings page, /addons/hmm/settings.cgi?cmd=config.
#HMM_AUTH_MODE=rega

# With HMM_AUTH_MODE=occulite: the box the handed-over session is checked against. The default is
# the box itself, behind its own lighttpd, which is right for every real installation.
#HMM_OCCULITE_URL=http://127.0.0.1

# With HMM_AUTH_MODE=rega or occulite: how long a login lasts without being used. Sliding - every request
# pushes it out again, so a tab that is in use never expires and one left open over the weekend
# does. Sessions live in this process only, so restarting the addon logs everybody out.
#HMM_SESSION_TTL=24h

# D-31: after this long with no browser page open, the backend de-registers from the interface
# processes (init('') per interface) and stops its service-message poll; the next page load
# subscribes again and shows "subscribing" for a moment. This is the default of the host, and it
# matters most here: on the CCU the events it saves are the CCU's own CPU. `0` keeps the
# subscriptions up permanently, which is only useful if something else on the CCU depends on this
# process holding them.
#HMM_IDLE_UNSUBSCRIBE=5m
