# The lighttpd rule of the Homematic Manager. etc/lighttpd.conf.in is the template, and
# update_script renders it into etc/lighttpd.conf beside it, with HMM_PORT from etc/hmm.env in
# place of the port placeholder (task 69). On a CCU and OpenCCU update_script then copies the
# rendered file to /usr/local/etc/config/lighttpd/hmm.conf, which both firmwares include (OpenCCU
# always, CCU3 firmware since 3.61.5), and the uninstall removes it again. On openccu-lite that
# directory is the system's: it makes its own validated copy of etc/lighttpd.conf and refreshes it
# at every lighttpd start and reload, and rc.d/hmm renders the file again at every start, so a port
# changed in etc/hmm.env reaches it.
#
# The pattern is RedMatic's, which proves on CCU3 firmware and OpenCCU alike that the CCU's
# lighttpd proxies a WebSocket: /addons/red/ to Node-RED on 1880 with
# `proxy.header = ("upgrade" => "enable")`, and the Node-RED editor's socket runs through it
# (D-25, D-28). The Homematic Manager UI talks to its backend over exactly one WebSocket
# (`ApiFrame` on <base>api), so that one line is what makes the addon work at all.
#
# The negative lookahead is the whole trick of using *one* prefix for both halves of the addon:
# /addons/hmm/ is the UI, served by the backend on 127.0.0.1:@PORT@ with `--base /addons/hmm`,
# while the three CGIs of the same name are served by lighttpd itself from
# /usr/local/etc/config/addons/www/hmm. Without the exclusion the settings page would be proxied
# into the backend and answered with 404, and the addon could never hand out its token.
#
# Both blocks are conditionals rather than global settings: a global `url.redirect` would replace
# whatever another addon's include had set.

$HTTP["url"] == "/addons/hmm" {
    url.redirect = ("^/addons/hmm$" => "/addons/hmm/")
}

$HTTP["url"] =~ "^/addons/hmm/(?!settings\.cgi|service\.cgi|update_check\.cgi)" {
    proxy.server = ("" => (("host" => "127.0.0.1", "port" => @PORT@)))
    proxy.header = ("upgrade" => "enable")
    server.errorfile-prefix = "/usr/local/addons/hmm/www/lighttpd-error-"
}
