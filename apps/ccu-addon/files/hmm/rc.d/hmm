#!/bin/sh
#
# Service script of the Homematic Manager CCU addon. Called by run-parts at boot ("init" from
# S55InitAddons, "start" from S98StartAddons), at shutdown ("stop"), and by the WebUI ("info",
# "info.de", "info.en", "restart", "uninstall"). service.cgi calls start/stop/restart/status.
#
# POSIX sh on purpose: this runs under busybox ash on both firmwares.

ADDON=hmm
ADDON_DIR=/usr/local/addons/hmm
CONF_DIR=/usr/local/etc/config
WWW_DIR=$CONF_DIR/addons/www/$ADDON
LIGHTTPD_CONF=$CONF_DIR/lighttpd/$ADDON.conf
# task 69: the lighttpd rule rendered into the addon's own tree, and its template
RULE=$ADDON_DIR/etc/lighttpd.conf
RULE_TEMPLATE=$ADDON_DIR/etc/lighttpd.conf.in
MONIT_CONF=/usr/local/etc/monit-$ADDON.cfg

# The profile: config.json (the CCU address, interfaces, ReGa, pacing - everything the settings
# dialog of the UI writes), the caches and the device image cache. Deliberately *outside*
# $ADDON_DIR, which an update replaces wholesale and an uninstall deletes.
STATE_DIR=/usr/local/hmm

NODE=$ADDON_DIR/bin/node
APP=$ADDON_DIR/app/dist/cli.js
ENV_FILE=$ADDON_DIR/etc/hmm.env
TOKEN_FILE=$STATE_DIR/token
# Not /var/run: the CCU3 firmware installs an addon inside a chroot it builds first, and that
# chroot binds /usr/local, /dev, /proc and /sys - not /var/run. `update_script`'s stop therefore
# found no pidfile there, reported "not running" and left the old backend on the replaced tree
# (measured in the lab on 2026-09-05). $ADDON_DIR/var is on /usr/local, so it exists in the chroot
# and in the running system alike.
PIDFILE=$ADDON_DIR/var/$ADDON.pid
# Task 43 (#159): on a CCU and OpenCCU the backend's output goes to one of two files, chosen with
# HMM_ADDON_LOG in etc/hmm.env. `varlog`, the default: /var/log/hmm.log, the CCU convention, on a tmpfs,
# so nothing is written to the SD card and the log is gone after a reboot. `addon`: the addon
# directory, which survives a reboot at the cost of SD-card writes. Both rotate at LOG_MAX.
VARLOG_DIR=/var/log
VARLOG_LOG=$VARLOG_DIR/hmm.log
ADDON_LOG=$ADDON_DIR/var/hmm.log
LOG=$VARLOG_LOG
LOG_MAX=1048576
# Task 41 (openccu-lite D-59): on openccu-lite everything logs to the journal, and nothing of ours
# writes a log file onto the SD card. The backend's output goes to journald under the unit's own
# identifier, so `journalctl -t addon-hmm`, `journalctl -u addon-hmm` and the box's Log page find it.
JOURNAL_TAG=addon-$ADDON

[ -f $ADDON_DIR/versions ] && . $ADDON_DIR/versions

# ICU keeps its data outside the libraries; without this node does not start (musl build)
[ -n "$NODE_ICU_DATA" ] && export ICU_DATA="$NODE_ICU_DATA"

Running() {
    [ -f $PIDFILE ] || return 1
    pid="$(cat $PIDFILE 2>/dev/null)"
    case "$pid" in
        '' | *[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 1
    # /var/run was a tmpfs and lost its pidfile at every boot; this one is on /usr/local and
    # survives one, so a pid the kernel handed to somebody else must not be taken for the addon.
    [ -r /proc/$pid/cmdline ] || return 0
    tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null | grep -q "$ADDON_DIR/app/"
}

# B-46: is the process of the pidfile alive - there, and not a zombie waiting to be reaped? What
# Start watches right after the start, where the pid is its own fresh one and its cmdline is in flux
# (see there). kill -0 answers yes for a zombie, so the state is read as well.
Alive() {
    pid="$(cat $PIDFILE 2>/dev/null)"
    case "$pid" in
        '' | *[!0-9]*) return 1 ;;
    esac
    kill -0 "$pid" 2>/dev/null || return 1
    ! grep -q '^State:[[:space:]]*Z' /proc/$pid/status 2>/dev/null
}

# The token the UI's browser has to present on the API socket. settings.cgi hands it out as a
# cookie after the WebUI session check; nobody else ever sees it, so it is root-only and lives in
# the profile directory, where it survives an update (and with it the open browser tab).
# Returns 1 when the file cannot be written or read - on openccu-lite the addon runs as its own
# user (D-36), and a profile directory still owned by root from an earlier life makes every line
# here fail with "Permission denied"; Start must then fail, not report OK with an empty token
# (openccu-lite B-62: the unit said "active (exited)", the Services page said "Completed").
Token() {
    if [ ! -s $TOKEN_FILE ]; then
        mkdir -p $STATE_DIR 2>/dev/null || return 1
        if command -v openssl >/dev/null 2>&1; then
            openssl rand -hex 32 > $TOKEN_FILE 2>/dev/null
        fi
        if [ ! -s $TOKEN_FILE ]; then
            { dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n' > $TOKEN_FILE && echo >> $TOKEN_FILE; } 2>/dev/null
        fi
        [ -s $TOKEN_FILE ] || { rm -f $TOKEN_FILE 2>/dev/null; return 1; }
        chmod 600 $TOKEN_FILE
    fi
    cat $TOKEN_FILE 2>/dev/null || return 1
}

# Tells the CCU's lighttpd about a rule file that changed or went away - through `reload`, never
# `restart`. Both callers - update_script and `uninstall` below - run *inside a request of that
# lighttpd*: the WebUI's cp_software.cgi execs /bin/install_addon (which runs update_script) and
# `rc.d/hmm uninstall`, and prints its "done" popup only when they return. A restart tears down the
# very connection that popup goes out on; the browser never hears back and the WebUI sits in its
# dialog until an F5 (#141). `reload` is a graceful restart on both firmwares: SIGUSR1 to lighttpd
# with server.graceful-restart-bg on OpenCCU (the new server takes over at once, running requests
# finish on the old one), SIGHUP to lighttpd-angel on the CCU3 firmware (graceful shutdown, then a
# fresh start). Where an init script has no `reload`, the restart is detached and delayed until the
# installer's answer is out. The twin of this function lives in update_script, which must not
# depend on the rc.d script of the version it replaces.
LighttpdReload() {
    [ -x /etc/init.d/S50lighttpd ] || return 0
    if ! /etc/init.d/S50lighttpd reload >/dev/null 2>&1; then
        nohup sh -c 'sleep 5; /etc/init.d/S50lighttpd restart' >/dev/null 2>&1 &
    fi
}

# Task 69: on openccu-lite, the lighttpd rule in the addon's own tree follows HMM_PORT at every start.
# The system reads only its own validated copy of etc/lighttpd.conf (openccu-lite B-120) and takes it
# at every lighttpd start and reload, so a port moved in etc/hmm.env needs nothing but a restart of
# the addon and a reload of lighttpd - no reinstall. The reload is asked for only as root: in its
# unit this runs as addon-hmm, which may not reload lighttpd, and then the syslog says the rule waits
# for the next reload (a reinstall, any addon install, a restart of lighttpd, the next boot).
# Called after hmm.env was sourced. Never fatal: the backend starts either way.
LiteRule() {
    [ -f $RULE_TEMPLATE ] || return 0
    if ! sed "s/@PORT@/$HMM_PORT/g" $RULE_TEMPLATE > $RULE.new 2>/dev/null; then
        rm -f $RULE.new 2>/dev/null
        logger -t $ADDON -p daemon.warn "cannot write $RULE as $(id -un): the lighttpd rule keeps its port"
        return 0
    fi
    if cmp -s $RULE.new $RULE; then
        rm -f $RULE.new
    else
        mv $RULE.new $RULE
    fi
    # what lighttpd reads: the system's copy, without the header line it puts on top
    if [ -f $LIGHTTPD_CONF ] \
        && [ "$(awk 'NR == 1 && /^# written by occulited from /{next} {print}' $LIGHTTPD_CONF 2>/dev/null)" = "$(cat $RULE)" ]; then
        return 0
    fi
    if [ "$(id -u)" = 0 ]; then
        logger -t $ADDON -p daemon.info "the lighttpd rule changed (port $HMM_PORT): reloading lighttpd"
        LighttpdReload
    else
        logger -t $ADDON -p daemon.notice "the lighttpd rule changed (port $HMM_PORT): it takes effect at lighttpd's next reload or start"
    fi
}

# Task 41: where the backend's output goes - "journal" on openccu-lite, a file everywhere else.
# Decided at every start from `/VERSION`, like the auth mode below and for the same reason: the same
# /usr/local may move between the firmwares. The output cannot simply be left to the unit: `-b` points
# the backend's stdio at /dev/null, and a restart from a CGI would hand it the CGI's pipe. systemd-cat
# connects stdout and stderr to journald and execs the backend, so the recorded pid stays node's own.
# Without systemd-cat a file stays, rather than no log at all.
# Task 43: the file is "varlog" (/var/log/hmm.log) unless etc/hmm.env says HMM_ADDON_LOG=addon; any
# other value is the default. Called after hmm.env was sourced.
LogTarget() {
    if grep -q '^VARIANT=lite$' /VERSION 2>/dev/null && command -v systemd-cat >/dev/null 2>&1; then
        echo journal
    elif [ "$HMM_ADDON_LOG" = addon ]; then
        echo addon
    else
        echo varlog
    fi
}

# B-32: `--lite-mode` and `--jitless` both switch off V8's WebAssembly, and node's fetch parses HTTP with
# llhttp compiled to WebAssembly: every fetch fails, and on openccu-lite the backend can no longer ask
# the box about a session, so nobody gets in. 3.0.0-beta.16 started node with `--lite-mode`, and its
# README showed `HMM_NODE_FLAGS=--lite-mode`. Whoever set them, they are dropped here with a log line;
# every other flag stays. Prints the flags to use.
NodeFlags() {
    kept=""
    set -f
    for flag in $1; do
        case "$flag" in
            --lite-mode | --lite_mode | --jitless)
                logger -t $ADDON -p daemon.warn "HMM_NODE_FLAGS: dropped $flag, which switches off WebAssembly, and node's fetch needs it (B-32)"
                ;;
            *) kept="${kept:+$kept }$flag" ;;
        esac
    done
    set +f
    printf '%s' "$kept"
}

# D-40, B-22: the auth mode on openccu-lite, printed. Called after hmm.env was sourced, only on a box
# whose /VERSION says VARIANT=lite.
#
# HMM_AUTH_MODE is the CCU's setting and is not read here: `token` is what every install from the
# CCU days wrote into hmm.env (task 13's default.env, the CCU's settings page), and the same
# /usr/local moved to openccu-lite then ran the backend in token mode, where the box's shell can never
# get in (B-22, the lab Charly after its upgrade). `rega` needs the CCU's ReGa and asks nothing else.
# The choice a user made on this firmware is HMM_AUTH_MODE_LITE, which the settings page writes on a
# lite box and a CCU never reads - so a /usr/local that moves between the firmwares carries one
# setting for each and neither is mistaken for the other. `token` counts only there, spelled exactly:
# a value that is neither `token` nor `occulite` - a typo, a CRLF - runs `occulite`, the box's
# default and its login, and says so in the syslog; nothing in either file can put a lite box into a
# mode of the CCU's.
LiteAuthMode() {
    case "$HMM_AUTH_MODE_LITE" in
        token | occulite)
            mode=$HMM_AUTH_MODE_LITE
            ;;
        '')
            mode=occulite
            ;;
        *)
            logger -t $ADDON -p daemon.warn "HMM_AUTH_MODE_LITE in etc/hmm.env is neither token nor occulite: --auth-mode occulite (B-22)"
            mode=occulite
            ;;
    esac
    if [ -n "$HMM_AUTH_MODE" ] && [ "$HMM_AUTH_MODE" != "$mode" ]; then
        logger -t $ADDON -p daemon.info "HMM_AUTH_MODE=$HMM_AUTH_MODE in etc/hmm.env is the CCU's setting and is not read on openccu-lite; HMM_AUTH_MODE_LITE chooses here (B-22)"
    fi
    printf '%s' "$mode"
}

Start() {
    if Running; then
        echo "$ADDON already running"
        return 0
    fi
    # a pidfile that outlived its process (a power cut, a kill -9): it would only confuse
    # start-stop-daemon and monit
    rm -f $PIDFILE 2>/dev/null
    # B-25: and one that cannot be removed stops start-stop-daemon from recording the new pid, so
    # nothing starts while everything below would still say OK. Seen on openccu-lite: a live install
    # as root left var/ and the pidfile root's, and the unit runs as addon-hmm.
    if [ -e $PIDFILE ]; then
        echo "Starting $ADDON: FAILED ($PIDFILE is left over and cannot be removed by $(id -un); is $ADDON_DIR/var owned by $(id -un)?)" >&2
        logger -t $ADDON -p daemon.err "cannot remove the stale $PIDFILE as $(id -un): not starting"
        return 1
    fi

    # The addon writes into $STATE_DIR and its own var/ and nowhere else. Enforced here rather than
    # left to the configuration: HOME on a CCU is /root on a read-only rootfs, and the host's
    # default profile directory would be $HOME/.config/homematic-manager.
    export HOME="$ADDON_DIR"
    export XDG_CACHE_HOME="$ADDON_DIR/var/cache"
    export XDG_CONFIG_HOME="$STATE_DIR"
    export TMPDIR="${TMPDIR:-/tmp}"

    # HMM_PORT and HMM_LOG_LEVEL, and anything else a user put there: every option of the host has
    # an HMM_* environment mirror, and the command line below wins over all of them.
    HMM_PORT=8090
    HMM_LOG_LEVEL=info
    # Task 35 (D-43): the callback ports the host takes while config.json says 0 - which it does
    # until somebody sets ports in the settings dialog, and ports set there always win, because
    # these two never reach config.json. Fixed instead of a new free port at every start: the
    # process behind VirtualDevices keeps its handlers by URL and does not drop the entry of a
    # backend that was killed (#144), while a fixed URL overwrites its own entry. A taken port is
    # not fatal, the host logs it and takes a free one for that start. hmm.env may move them, or set
    # 0 for a free port at every start. Why these two numbers: README, "Callback ports".
    HMM_CALLBACK_XMLRPC_DEFAULT_PORT=2031
    HMM_CALLBACK_BINRPC_DEFAULT_PORT=2032
    # task 43: unset means /var/log/hmm.log
    HMM_ADDON_LOG=varlog
    # B-32 (task 44, D-46): flags for node itself, read here and never by the host. Memory flags that
    # leave WebAssembly alone (README, "Memory"): 3.0.0-beta.16's `--lite-mode` switched it off, and
    # node's fetch cannot work without it. hmm.env may set other flags, or `HMM_NODE_FLAGS=` for none;
    # NodeFlags takes out the ones that switch WebAssembly off, wherever they came from.
    HMM_NODE_FLAGS="--max-semi-space-size=1 --optimize-for-size"
    if [ -f $ENV_FILE ]; then
        set -a
        # shellcheck source=/dev/null
        . $ENV_FILE
        set +a
    fi
    HMM_NODE_FLAGS="$(NodeFlags "$HMM_NODE_FLAGS")"
    # D-40: openccu-lite has no ReGaHSS and its own users, so `rega` cannot work there and the
    # box's own hand-over can: its shell opens an addon page with the user's session on the URL and
    # this host checks that session against the box. Decided **at every start** from the firmware's
    # own `/VERSION` (their D-17 keeps PRODUCT and PLATFORM and adds `VARIANT=lite`), never written
    # into hmm.env - the same /usr/local may be moved from openccu-lite to OpenCCU and back, and a
    # remembered answer would be wrong on the other side. On a CCU, HMM_AUTH_MODE as the user set it
    # (unset: the host's default, token); on openccu-lite, HMM_AUTH_MODE_LITE (B-22, LiteAuthMode).
    if grep -q '^VARIANT=lite$' /VERSION 2>/dev/null; then
        HMM_AUTH_MODE="$(LiteAuthMode)"
        logger -t $ADDON -p daemon.info "openccu-lite detected (VARIANT=lite): --auth-mode $HMM_AUTH_MODE"
        LiteRule
    fi
    [ -n "$HMM_AUTH_MODE" ] && export HMM_AUTH_MODE

    export HMM_PORT HMM_LOG_LEVEL HMM_CALLBACK_XMLRPC_DEFAULT_PORT HMM_CALLBACK_BINRPC_DEFAULT_PORT

    # not on the command line: an argument is world-readable in `ps`, the environment is not
    if ! HMM_TOKEN="$(Token)" || [ -z "$HMM_TOKEN" ]; then
        echo "Starting $ADDON: FAILED ($TOKEN_FILE cannot be written; is $STATE_DIR owned by $(id -un)?)" >&2
        logger -t $ADDON -p daemon.err "cannot write $TOKEN_FILE as $(id -un): not starting"
        return 1
    fi
    export HMM_TOKEN

    mkdir -p $ADDON_DIR/var $ADDON_DIR/var/cache $STATE_DIR 2>/dev/null
    LOG_TARGET="$(LogTarget)"
    # Task 43, B-25 for /var/log: a /var/log that cannot be created or written (a firmware without one,
    # a user that may not write it) must not start the backend without a log, nor stop it from
    # starting. The addon directory takes the log instead, and syslog says why.
    if [ "$LOG_TARGET" = varlog ]; then
        mkdir -p $VARLOG_DIR 2>/dev/null
        if [ ! -w $VARLOG_DIR ] || { [ -e $VARLOG_LOG ] && { [ ! -f $VARLOG_LOG ] || [ ! -w $VARLOG_LOG ]; }; }; then
            logger -t $ADDON -p daemon.warn "cannot write $VARLOG_LOG as $(id -un): logging to $ADDON_LOG instead"
            LOG_TARGET=addon
        fi
    fi
    case "$LOG_TARGET" in
        varlog)
            LOG=$VARLOG_LOG
            OTHER_LOG=$ADDON_LOG
            ;;
        *)
            LOG=$ADDON_LOG
            OTHER_LOG=$VARLOG_LOG
            ;;
    esac
    # B-25: the backend's output goes to $LOG and start-stop-daemon writes $PIDFILE; when var/ is
    # not this user's, both fail inside the background start where nobody sees it
    if [ ! -w $ADDON_DIR/var ] || { [ "$LOG_TARGET" = addon ] && [ -e $LOG ] && [ ! -w $LOG ]; }; then
        echo "Starting $ADDON: FAILED ($ADDON_DIR/var cannot be written by $(id -un); is it owned by $(id -un)?)" >&2
        logger -t $ADDON -p daemon.err "cannot write $ADDON_DIR/var as $(id -un): not starting"
        return 1
    fi
    if [ "$LOG_TARGET" = journal ]; then
        # the file an earlier version wrote, or this /usr/local on a CCU: nothing writes it any more,
        # so it goes - once, since there is nothing left to remove at the next start
        if [ -e $ADDON_LOG ] || [ -e $ADDON_LOG.1 ]; then
            rm -f $ADDON_LOG $ADDON_LOG.1 2>/dev/null
            logger -t $ADDON -p daemon.info "openccu-lite: the log is the journal now (journalctl -t $JOURNAL_TAG); removed $ADDON_LOG"
        fi
        RUN="exec systemd-cat -t $JOURNAL_TAG $NODE"
        OUTPUT=""
    else
        # Task 43: the file of the location not chosen goes, once, so the log views never show a stale
        # log and nothing old stays on the SD card. Nothing writes it any more; a start after a switch
        # is the only time there is anything to remove.
        if [ -e $OTHER_LOG ] || [ -e $OTHER_LOG.1 ]; then
            if rm -f $OTHER_LOG $OTHER_LOG.1 2>/dev/null; then
                logger -t $ADDON -p daemon.info "the log is $LOG now; removed $OTHER_LOG"
            fi
        fi
        if [ -f $LOG ] && [ "$(wc -c < $LOG)" -gt $LOG_MAX ]; then
            mv $LOG $LOG.1
        fi
        RUN="exec $NODE"
        OUTPUT=">>$LOG 2>&1"
    fi

    printf '%s' "Starting $ADDON: "
    logger -t $ADDON -p daemon.info "starting homematic-manager $VERSION_ADDON (node $NODE_VERSION) on 127.0.0.1:$HMM_PORT"
    # cd / because the OpenCCU installer deletes its temp directory right after update_script
    # returns, and a process whose cwd is gone cannot spawn children.
    # sh -c "exec ..." so the recorded pid is node's own, not a wrapper's (systemd-cat execs too).
    cd / || return 1
    if ! start-stop-daemon -S -b -m -p $PIDFILE -x /bin/sh -- -c "$RUN $HMM_NODE_FLAGS $APP \
--local --ccu 127.0.0.1 --base /addons/$ADDON --host 127.0.0.1 --no-issue-cookie \
--data-dir $STATE_DIR $OUTPUT"; then
        echo "FAILED (start-stop-daemon could not start $NODE)"
        logger -t $ADDON -p daemon.err "start-stop-daemon could not start $NODE"
        return 1
    fi

    # B-25: with -b, start-stop-daemon returns as soon as it has forked, whatever node does next.
    # A backend that cannot run (no runtime, a log it cannot write, an exception at start) is gone
    # within a moment, so three seconds of watching turn that into FAILED instead of OK - and the
    # exit code the unit and the WebUI's service page go by.
    # B-46: watched with Alive, not Running. The pid start-stop-daemon recorded is sh's, which execs
    # systemd-cat, which execs node - and during each of those execs /proc/<pid>/cmdline reads empty,
    # so Running's grep for the app's path said "gone" for a live backend; two such misses within the
    # few milliseconds between the loop's check and the verdict below made FAILED, and on openccu-lite
    # the failing unit then killed the backend before it had logged a line. Seen on the fast x86 lab
    # box at its first boot after an image update, when the page cache is cold and every exec reads
    # from disk; measured there with a dropped page cache. The pid is fresh - this function removed
    # the pidfile before the start - so whether it is alive is the whole question here; Running's
    # look at the cmdline is for the other callers, where a pid recycled after a reboot is the point.
    i=0
    while [ $i -lt 3 ] && Alive; do
        sleep 1
        i=$((i + 1))
    done
    if ! Alive; then
        pid="$(cat $PIDFILE 2>/dev/null)"
        case "$pid" in
            '' | *[!0-9]*) why="no pid was recorded" ;;
            *) why="pid $pid is gone" ;;
        esac
        if [ "$LOG_TARGET" = journal ]; then
            echo "FAILED (the backend exited right after the start: $why; see journalctl -t $JOURNAL_TAG)"
            logger -t $ADDON -p daemon.err "homematic-manager exited right after the start ($why); see journalctl -t $JOURNAL_TAG"
        else
            echo "FAILED (the backend exited right after the start: $why; see $LOG)"
            tail -n 5 $LOG 2>/dev/null
            logger -t $ADDON -p daemon.err "homematic-manager exited right after the start ($why); see $LOG"
        fi
        rm -f $PIDFILE 2>/dev/null
        return 1
    fi

    # under memory pressure the kernel should take this before it takes rfd or ReGaHSS
    echo 800 > /proc/"$(cat $PIDFILE)"/oom_score_adj 2>/dev/null

    # `ONREBOOT NOSTART` in monit.cfg leaves the check **unmonitored** every time monit starts or
    # reloads - measured on both OpenCCU lab boxes 2026-09-05, where `monit status hmm` said "Not
    # monitored" after a clean install, so none of the alerts in monit.cfg could ever fire. Arming
    # it here is RedMatic's `bin/monit-start`: the addon is up, so monit may watch it; the delay is
    # because monit needs a cycle before a freshly reloaded check accepts `monitor`.
    if [ -x /usr/bin/monit ] && [ -e $MONIT_CONF ]; then
        nohup sh -c 'sleep 20; /usr/bin/monit -g hmm monitor' >/dev/null 2>&1 &
    fi
    echo "OK"
}

Stop() {
    # before the checks below, so a deliberate stop is not reported as a failure
    if [ -x /usr/bin/monit ] && [ -e $MONIT_CONF ]; then
        /usr/bin/monit -g $ADDON unmonitor >/dev/null 2>&1
    fi
    if ! Running; then
        rm -f $PIDFILE
        echo "$ADDON not running"
        return 1
    fi
    printf '%s' "Stopping $ADDON: "
    logger -t $ADDON -p daemon.info "stopping homematic-manager"
    # SIGTERM makes the host de-register its callbacks from the interface processes; give it time
    start-stop-daemon -K -q -p $PIDFILE
    i=0
    while Running && [ $i -lt 15 ]; do
        sleep 1
        i=$((i + 1))
    done
    if Running; then
        logger -t $ADDON -p daemon.warn "killing homematic-manager"
        kill -9 "$(cat $PIDFILE)" 2>/dev/null
    fi
    rm -f $PIDFILE
    echo "OK"
}

# B-134: the Config-Url, printed. On a CCU it is the Systemsteuerung button that opens the app
# (D-32: settings.cgi checks the WebUI session and hands the browser over with the token cookie), and
# the settings page is linked from the description. On openccu-lite the app has its own entry in the
# addon menu, and the shell frames the Config-Url behind the gear and the Settings button - there it
# has to be the settings page. Read from /VERSION like everything else that differs between the two,
# never remembered. update_script writes the same into hm_addons.cfg.
ConfigUrl() {
    if grep -q '^VARIANT=lite$' /VERSION 2>/dev/null; then
        printf '%s' "/addons/$ADDON/settings.cgi?cmd=config"
    else
        printf '%s' "/addons/$ADDON/settings.cgi"
    fi
}

case "$1" in
    init)
        # called before the CCU interfaces are up - nothing to prepare, start happens later
        exit 0
        ;;

    start)
        Start || exit 1
        ;;

    stop)
        Stop
        ;;

    restart)
        Stop
        sleep 2
        Start || exit 1
        ;;

    status)
        if Running; then
            echo "$ADDON running, pid $(cat $PIDFILE)"
        else
            echo "$ADDON stopped"
            exit 1
        fi
        ;;

    info)
        # HTML entities, not umlauts (#140): cp_software.cgi reads these lines through a Tcl pipe
        # whose system encoding is iso8859-1 on the CCU3 and on OpenCCU alike, and writes them into
        # the WebUI's Latin-1 page as they are - a UTF-8 "ä" arrives as "Ã¤", and a Latin-1 byte
        # would break the day some firmware runs Tcl in a UTF-8 locale. An entity survives both.
        # The same goes for hmm.cfg, whose description the Systemsteuerung page renders.
        echo "Info: <div>Homematic Manager - Ger&auml;te, Verkn&uuml;pfungen, Parameter - <a target=\"_blank\" href=\"https://github.com/hobbyquaker/homematic-manager\">github.com/hobbyquaker/homematic-manager</a></div>"
        echo "Name: Homematic Manager"
        echo "Version: $VERSION_ADDON"
        echo "Update: /addons/$ADDON/update_check.cgi"
        echo "Config-Url: $(ConfigUrl)"
        echo "Operations: restart uninstall"
        ;;

    uninstall)
        # The WebUI calls this without an argument and then deletes the rc.d script itself. The
        # profile directory is *kept*: it holds the CCU configuration the user made in the UI.
        # `uninstall purge` deletes that too.
        Stop
        $ADDON_DIR/bin/update_addon $ADDON
        if [ -L $MONIT_CONF ] || [ -f $MONIT_CONF ]; then
            rm -f $MONIT_CONF
            [ -x /usr/bin/monit ] && /usr/bin/monit reload >/dev/null 2>&1
        fi
        # The rendered rule first: on openccu-lite the reload below runs the system's sync, which
        # must not find it and copy it back. The drop-in is a CCU's and OpenCCU's rule; on
        # openccu-lite it is the system's copy, which the system removes by itself once
        # etc/lighttpd.conf is gone (task 69), and an older rendering an earlier version left there
        # goes here while this still runs as root. As the addon's user (B-119) the rm fails quietly
        # and the system's sync after the uninstall does it.
        rm -f $RULE 2>/dev/null
        if [ -f $LIGHTTPD_CONF ] && rm -f $LIGHTTPD_CONF 2>/dev/null; then
            LighttpdReload
        fi
        rm -f $CONF_DIR/rc.d/$ADDON
        rm -rf $WWW_DIR
        rm -rf $ADDON_DIR
        # task 43: the log outside the addon tree goes with it
        rm -f $VARLOG_LOG $VARLOG_LOG.1 2>/dev/null
        if [ "$2" = purge ]; then
            rm -rf $STATE_DIR
            logger -t $ADDON -p daemon.info "uninstalled homematic-manager, profile purged"
        else
            logger -t $ADDON -p daemon.info "uninstalled homematic-manager, profile kept in $STATE_DIR"
        fi
        ;;

    *)
        # cp_software.cgi parses every line of `info.<lang>` output, so an unknown command has to
        # stay quiet on stdout
        echo "Usage: $ADDON {init|start|stop|restart|status|info|uninstall [purge]}" >&2
        exit 1
        ;;
esac

exit 0
