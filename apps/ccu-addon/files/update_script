#!/bin/sh
#
# Runs on the CCU when the package is installed or updated through
# Systemsteuerung -> Zusatzsoftware, with the extracted package as the working directory.
#
# Everything happens inside /usr/local/addons/hmm, /usr/local/hmm (the profile) plus four links the
# platform provides for exactly this: rc.d, addons/www, hm_addons.cfg and the lighttpd config
# directory (not on openccu-lite, where that directory is the system's - task 69). No system file is patched, no binary is placed in /usr/local/bin, no profile or PATH is
# touched - another addon's Node.js (RedMatic ships one too) stays untouched and this one's runtime
# is invisible to it.
#
# POSIX sh: busybox ash runs this, on the CCU3 inside a chroot at shutdown and on OpenCCU live.

ADDON=hmm
ADDONS_DIR=/usr/local/addons
CONF_DIR=/usr/local/etc/config
ADDON_DIR=$ADDONS_DIR/$ADDON
WWW_DIR=$CONF_DIR/addons/www/$ADDON
STATE_DIR=/usr/local/hmm
LIGHTTPD_DIR=$CONF_DIR/lighttpd
LIGHTTPD_CONF=$LIGHTTPD_DIR/$ADDON.conf
# task 69: the rule rendered into the addon's own tree, from the template beside it
RULE=$ADDON_DIR/etc/lighttpd.conf
RULE_TEMPLATE=$ADDON_DIR/etc/lighttpd.conf.in
PIDFILE=$ADDON_DIR/var/$ADDON.pid
# where installations from before 2026-09-06 keep it, and where this script cannot see it on the
# CCU3 firmware: that install runs in a chroot which binds /usr/local, /dev, /proc and /sys only
LEGACY_PIDFILE=/var/run/$ADDON.pid

# 10 tells the WebUI this was a fresh install (it then offers a reboot), 0 an update. The CCU3
# firmware ignores the code and always reboots; OpenCCU installs live and only reboots on 10.
EXITCODE=10

mount | grep -q ' /usr/local ' || mount /usr/local

# One package per architecture: refuse a wrong one rather than install a runtime that cannot start.
# 13 is the conventional "unsupported platform" code; the WebUI shows it as Error (13).
PKG_ARCH=""
if [ -f $ADDON/versions ]; then
    PKG_ARCH="$(sed -n 's/^NODE_ARCH="\(.*\)"$/\1/p' $ADDON/versions)"
fi
MACHINE="$(uname -m)"
if [ -n "$PKG_ARCH" ] && [ "$PKG_ARCH" != "$MACHINE" ]; then
    logger -t $ADDON -p daemon.err "package is for $PKG_ARCH, this CCU is $MACHINE"
    echo "this package is for $PKG_ARCH, this system is $MACHINE" >&2
    exit 13
fi

# openccu-lite (its /VERSION says VARIANT=lite; the CCU3's install chroot has no /VERSION and is a
# CCU). Read once here, like rc.d/hmm reads it at every start.
LITE=0
grep -q '^VARIANT=lite$' /VERSION 2>/dev/null && LITE=1

mkdir -p $ADDONS_DIR $CONF_DIR/rc.d $CONF_DIR/addons/www $STATE_DIR
[ "$LITE" = 1 ] || mkdir -p $LIGHTTPD_DIR
chmod 755 $ADDONS_DIR

# Every pid that is this addon's backend. The pid files first - the one inside the addon tree, which
# is on /usr/local and is therefore visible from the CCU3 install chroot too, and the /var/run one
# an installation from before that change still writes - and then /proc, which finds the process
# when neither pid file can be read from here. /proc is bound into the chroot, so this works there.
AddonPids() {
    for file in $PIDFILE $LEGACY_PIDFILE; do
        [ -f "$file" ] || continue
        pid="$(cat "$file" 2>/dev/null)"
        case "$pid" in
            '' | *[!0-9]*) continue ;;
        esac
        [ -d /proc/"$pid" ] && echo "$pid"
    done
    for dir in /proc/[0-9]*; do
        pid="${dir#/proc/}"
        [ "$pid" = "$$" ] && continue
        cmdline="$(tr '\0' ' ' < "$dir/cmdline" 2>/dev/null)" || continue
        case "$cmdline" in
            *"$ADDON_DIR/app/"*) echo "$pid" ;;
        esac
    done
}

# Was the addon running when this update started?
#
# It is also the answer to "is this a live system". The firmware's own install runs with the addon
# stopped - on the CCU3 it happens around a reboot, in a chroot - and only an `install_addon` driven
# by hand on a running box finds its own process alive. The lab measured what that costs when the
# stop below silently does nothing: the old backend keeps running on the deleted inodes of the tree
# this script replaces, and the box needs a restart by hand to finish the update.
WAS_RUNNING=0
[ -n "$(AddonPids)" ] && WAS_RUNNING=1

if [ -x $CONF_DIR/rc.d/$ADDON ]; then
    EXITCODE=0
    $CONF_DIR/rc.d/$ADDON stop >/dev/null 2>&1
fi

# ... and whatever that did not reach, by pid file or by name. On OpenCCU the stop above has already
# done it and this finds nothing; on the CCU3 it is the one that works, because `rc.d/hmm stop` of
# the *installed* (old) version still looks for its pidfile in the /var/run the chroot does not have.
StopOld() {
    pids="$(AddonPids | sort -u)"
    [ -n "$pids" ] || return 0
    logger -t $ADDON -p daemon.info "stopping the running backend before the update: $pids"
    # shellcheck disable=SC2086
    kill $pids 2>/dev/null
    i=0
    while [ $i -lt 15 ]; do
        pids="$(AddonPids | sort -u)"
        [ -n "$pids" ] || return 0
        sleep 1
        i=$((i + 1))
    done
    logger -t $ADDON -p daemon.warn "killing the running backend: $pids"
    # shellcheck disable=SC2086
    kill -9 $pids 2>/dev/null
    rm -f $PIDFILE $LEGACY_PIDFILE
}
StopOld

# The host's configuration survives updates; the addon tree itself is replaced wholesale, so a file
# removed in a new version cannot survive. The profile directory ($STATE_DIR) is never touched here.
if [ -f $ADDON_DIR/etc/hmm.env ]; then
    cp $ADDON_DIR/etc/hmm.env /tmp/hmm.env.keep
fi

rm -rf $ADDON_DIR
cp -af $ADDON $ADDONS_DIR/

if [ -f /tmp/hmm.env.keep ]; then
    mv /tmp/hmm.env.keep $ADDON_DIR/etc/hmm.env
else
    cp $ADDON_DIR/etc/default.env $ADDON_DIR/etc/hmm.env
fi

# B-32: 3.0.0-beta.16 started node with --lite-mode, which switches off WebAssembly, and node's fetch
# needs it: every fetch of the backend failed, and on openccu-lite no session was let in. A kept
# hmm.env loses what that release put into it or told users to put there. Its default.env comment,
# which calls --lite-mode the default, is replaced by the current one, and --lite-mode or --jitless
# leave an HMM_NODE_FLAGS line, with a log line each. A line left without a flag goes, so the addon's
# default applies again; an empty `HMM_NODE_FLAGS=` and every other flag a user set stay as they are.
# rc.d/hmm drops the two at every start too (NodeFlags), for a file edited after the update.
MigrateNodeFlags() {
    env_file=$1
    [ -f "$env_file" ] || return 0
    old_1="# Task 44: flags for node itself, read by the rc.d script and not by the host. The default is"
    old_2="# --lite-mode, V8 without its optimising compilers, which keeps the backend's memory down (the"
    old_3="# addon's README, \"Memory\"). Empty runs node without flags, as before 3.0.0-beta.16."
    new_comment="# B-32: flags for node itself, read by the rc.d script and not by the host. Unset, node runs with
# the addon's memory flags (the addon's README, \"Memory\"); empty runs it without flags. --lite-mode
# and --jitless are dropped wherever they are set: both switch off WebAssembly, and node's fetch
# needs it (3.0.0-beta.16 started node with --lite-mode, and the addon could not log anybody in)."
    changed=0
    : > "$env_file.new" || return 0
    set -f
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            "$old_1")
                printf '%s\n' "$new_comment" >> "$env_file.new"
                changed=1
                continue
                ;;
            "$old_2" | "$old_3")
                changed=1
                continue
                ;;
            HMM_NODE_FLAGS=*)
                # the value as rc.d/hmm reads it: quotes and a trailing comment are the shell's business
                value="$(HMM_NODE_FLAGS=; eval "$line" 2>/dev/null; printf '%s' "$HMM_NODE_FLAGS")"
                kept=""
                dropped=""
                for flag in $value; do
                    case "$flag" in
                        --lite-mode | --lite_mode | --jitless) dropped="${dropped:+$dropped }$flag" ;;
                        *) kept="${kept:+$kept }$flag" ;;
                    esac
                done
                if [ -n "$dropped" ]; then
                    changed=1
                    if [ -n "$kept" ]; then
                        printf 'HMM_NODE_FLAGS="%s"\n' "$kept" >> "$env_file.new"
                        logger -t $ADDON -p daemon.warn "etc/hmm.env: took $dropped out of HMM_NODE_FLAGS, now \"$kept\": it switches off WebAssembly, which node's fetch needs (B-32)"
                    else
                        logger -t $ADDON -p daemon.warn "etc/hmm.env: removed the line HMM_NODE_FLAGS=$value: $dropped switches off WebAssembly, which node's fetch needs (B-32); the addon's default flags apply"
                    fi
                    continue
                fi
                ;;
        esac
        printf '%s\n' "$line" >> "$env_file.new"
    done < "$env_file"
    set +f
    # written into the same file, so its owner and mode stay
    [ "$changed" = 1 ] && cat "$env_file.new" > "$env_file"
    rm -f "$env_file.new"
}
MigrateNodeFlags $ADDON_DIR/etc/hmm.env

# The token the UI's browser gets from settings.cgi after the WebUI session check, and the only
# thing that opens the backend's API socket. Root-only, in the profile directory, so it survives an
# update and an open browser tab keeps working across one.
if [ ! -s $STATE_DIR/token ]; then
    if command -v openssl >/dev/null 2>&1; then
        openssl rand -hex 32 > $STATE_DIR/token 2>/dev/null
    fi
    if [ ! -s $STATE_DIR/token ]; then
        dd if=/dev/urandom bs=32 count=1 2>/dev/null | od -An -tx1 | tr -d ' \n' > $STATE_DIR/token
        echo >> $STATE_DIR/token
    fi
fi
chmod 600 $STATE_DIR/token
chmod 700 $STATE_DIR

# The device image cache is re-fetched from the CCU on demand; keep it out of the backup.
mkdir -p $STATE_DIR/images
touch $STATE_DIR/images/.nobackup

ln -sfn $ADDON_DIR/rc.d/$ADDON $CONF_DIR/rc.d/$ADDON
rm -rf $WWW_DIR
ln -sfn $ADDON_DIR/www $WWW_DIR

# entry in Systemsteuerung
touch $CONF_DIR/hm_addons.cfg
# B-134: on a CCU the CONFIG_URL is the button that opens the app (D-32), and the settings page is
# linked from the description. On openccu-lite the app has its own entry in the addon menu and the
# shell frames the CONFIG_URL behind the gear and the Settings button, so there it names the settings
# page - for a box whose catalogue entry does not say so itself. rc.d/hmm's ConfigUrl says the same
# in `info`. /VERSION as rc.d/hmm reads it; a firmware without one (the CCU3's install chroot) is a CCU.
ADDON_CFG=$ADDON.cfg
if [ "$LITE" = 1 ]; then
    ADDON_CFG=$ADDON-lite.cfg
    sed "s|{CONFIG_URL /addons/$ADDON/settings.cgi |{CONFIG_URL /addons/$ADDON/settings.cgi?cmd=config |" \
        $ADDON.cfg > $ADDON_CFG
fi
$ADDON_DIR/bin/update_addon $ADDON $ADDON_CFG

# The lighttpd rule that puts the UI (and its WebSocket) under /addons/hmm/. The port is the one in
# etc/hmm.env, so a user who moves the port and re-runs this gets a matching rule. Task 69: rendered
# into the addon's own tree, etc/lighttpd.conf from the template etc/lighttpd.conf.in, and compared
# with what lighttpd reads: on an update it is nearly always the same, and then lighttpd is not told
# anything at all (see LighttpdReload below - #141).
#   - A CCU and OpenCCU read /usr/local/etc/config/lighttpd/hmm.conf, and this copies the rule there.
#   - openccu-lite reads only the system's own validated copy of etc/lighttpd.conf in that directory,
#     made at every lighttpd start and reload and after every install (openccu-lite B-120), and
#     nothing of the addon writes there: once the installer runs as the addon's user (B-119) it
#     cannot. Its copy starts with a header line of its own, which the comparison leaves out.
HMM_PORT=8090
# shellcheck disable=SC1090
. $ADDON_DIR/etc/hmm.env
sed "s/@PORT@/$HMM_PORT/g" $RULE_TEMPLATE > $RULE
RULE_CHANGED=1
if [ "$LITE" = 1 ]; then
    if [ -f $LIGHTTPD_CONF ] \
        && [ "$(awk 'NR == 1 && /^# written by occulited from /{next} {print}' $LIGHTTPD_CONF)" = "$(cat $RULE)" ]; then
        RULE_CHANGED=0
    fi
elif cmp -s $RULE $LIGHTTPD_CONF 2>/dev/null; then
    RULE_CHANGED=0
else
    cp $RULE $LIGHTTPD_CONF.new && mv $LIGHTTPD_CONF.new $LIGHTTPD_CONF
fi

# monit exists on OpenCCU, not on the CCU3 firmware
if [ -x /usr/bin/monit ]; then
    ln -sf $ADDON_DIR/etc/monit.cfg /usr/local/etc/monit-$ADDON.cfg
    /usr/bin/monit reload >/dev/null 2>&1
fi

sync

# Tells lighttpd about a rule file that changed - through `reload`, never `restart`. This script
# runs *inside a request of the CCU's own lighttpd*: the WebUI's cp_software.cgi execs
# /bin/install_addon and prints its "installation successful" popup only when that has returned. A
# restart here tears down the very connection that popup goes out on; the browser never hears back
# and the WebUI sits in its dialog until an F5 (#141, reported on OpenCCU). `reload` is a graceful
# restart on both firmwares: SIGUSR1 to lighttpd with server.graceful-restart-bg on OpenCCU (the new
# server takes over at once, running requests finish on the old one), SIGHUP to lighttpd-angel on
# the CCU3 firmware. Where an init script has no `reload`, the restart is detached and delayed until
# the installer's answer is out. The twin of this function is in rc.d/hmm, for `uninstall`.
LighttpdReload() {
    [ -x /etc/init.d/S50lighttpd ] || return 0
    if ! /etc/init.d/S50lighttpd reload >/dev/null 2>&1; then
        nohup sh -c 'sleep 5; /etc/init.d/S50lighttpd restart' >/dev/null 2>&1 &
    fi
}

# On OpenCCU the install is live: lighttpd has to pick a new or changed rule up, and nothing else
# (on openccu-lite the reload runs the system's sync, which takes the rendered rule; after an install
# through its Addons page it syncs and reloads by itself as well, which is what remains once this
# script runs as the addon's user and may not reload lighttpd)
# would start the service - not on an update (exit code 0, the WebUI shows its "successful" popup
# and stays up) and not on a fresh install either, where OpenCCU reboots on exit code 10 but a
# firmware without that convention (openccu-lite asks first) may not.
# `cd /` first: the OpenCCU installer deletes this working directory the moment this script returns.
if [ ! -f /etc/init.d/S00InstallAddon ]; then
    cd /
    [ "$RULE_CHANGED" = 1 ] && LighttpdReload
    $CONF_DIR/rc.d/$ADDON start >/dev/null 2>&1
elif [ "$WAS_RUNNING" = 1 ]; then
    # The CCU3 firmware, driven by hand on a running box. Its installer wraps this script in a
    # chroot it builds under /usr/local, and that directory is gone when the install returns - a
    # backend started from in there would keep it as its root and lose /usr/local, and with it the
    # profile it writes. /proc *is* bound into the chroot, so /proc/1/root is the real root of the
    # running system and the service can be started where it belongs. Off the chroot (a firmware
    # that runs this script directly) /proc/1/root is the same root and this is a plain start.
    #
    # Nothing is started when the addon was not running: that is the firmware's own install around
    # a reboot, where the boot (S98StartAddons) starts the addon, and a fresh install there asks
    # for that reboot anyway (exit code 10).
    cd /
    HOST_ROOT=/proc/1/root
    if command -v chroot >/dev/null 2>&1 && [ -x $HOST_ROOT$CONF_DIR/rc.d/$ADDON ]; then
        chroot $HOST_ROOT $CONF_DIR/rc.d/$ADDON start >/dev/null 2>&1
    else
        $CONF_DIR/rc.d/$ADDON start >/dev/null 2>&1
    fi
fi

exit $EXITCODE
