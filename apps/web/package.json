{
  "name": "homematic-manager",
  "version": "3.0.0-beta.1",
  "type": "module",
  "description": "Configure and administer Homematic and HomematicIP devices - devices and channels, direct links, paramsets, RSSI, service messages, events and an RPC console - from a local HTTP/WebSocket server that also serves the web UI",
  "keywords": [
    "homematic",
    "homematicip",
    "ccu",
    "ccu3",
    "openccu",
    "raspberrymatic",
    "homegear",
    "xmlrpc",
    "smarthome"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "Sebastian 'hobbyquaker' Raff <hobbyquaker@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/homematic-manager.git",
    "directory": "apps/web"
  },
  "bugs": {
    "url": "https://github.com/hobbyquaker/homematic-manager/issues"
  },
  "homepage": "https://github.com/hobbyquaker/homematic-manager#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "homematic-manager": "./dist/cli.js",
    "homematic-manager-web": "./dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts",
    "ui",
    "!ui/**/*.map",
    "data",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "npm run build && node dist/dev.js",
    "start": "npm run build && node dist/cli.js",
    "prepack": "node scripts/prepack.mjs",
    "postpack": "node scripts/postpack.mjs",
    "sbom": "node scripts/sbom.mjs"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^4.2.1",
    "hm-simulator": "^1.0.0"
  },
  "dependencies": {
    "@homematic-manager/backend": "3.0.0-beta.1",
    "@homematic-manager/core": "3.0.0-beta.1",
    "binrpc": "^4.2.0",
    "homematic-rega": "^2.0.0",
    "homematic-xmlrpc": "^2.0.0",
    "ws": "^8.21.3"
  },
  "bundleDependencies": [
    "@homematic-manager/backend",
    "@homematic-manager/core"
  ]
}
