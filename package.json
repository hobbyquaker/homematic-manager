{
  "name": "homematic-manager",
  "version": "3.0.0-beta.2",
  "private": true,
  "type": "module",
  "description": "Homematic device configuration and administration",
  "license": "AGPL-3.0-or-later",
  "author": "Sebastian 'hobbyquaker' Raff <hobbyquaker@gmail.com>",
  "contributors": [
    "André 'Anli' Litfin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/homematic-manager.git"
  },
  "bugs": {
    "url": "https://github.com/hobbyquaker/homematic-manager/issues"
  },
  "homepage": "https://github.com/hobbyquaker/homematic-manager",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "data"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "lint:sh": "sh scripts/lint-sh.sh",
    "format": "prettier --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test --project=web",
    "test:e2e:electron": "playwright test --project=electron --max-failures=3",
    "test:e2e:cov": "c8 --reporter=lcovonly --report-dir=coverage-e2e --temp-directory=.playwright-coverage --exclude='**/node_modules/**' --exclude='**/*.test.*' --exclude='**/test/**' --exclude='playwright.config.ts' --exclude='**/*.config.ts' playwright test --project=web",
    "coverage:report": "node scripts/coverage-report.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "build": "npm run build --workspaces --if-present",
    "version:dev": "node scripts/version-dev.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "c8": "^10.1.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
