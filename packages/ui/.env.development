# `npm run dev -w @homematic-manager/ui` opens the app on the demo fixture, so the UI can be worked
# on without a backend or a CCU. Vite loads this file in dev only; the production build never sees
# it. Override with `VITE_HMM_DEMO=false npm run dev -w @homematic-manager/ui` to talk to a real
# backend (apps/web, task 12), or append `?demo` to any deployed URL to get the fixture back.
VITE_HMM_DEMO=true
